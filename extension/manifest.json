{
  "manifest_version": 3,
  "name": "TRFFN VulnWatch",
  "version": "0.1.0",
  "minimum_chrome_version": "123",
  "description": "Passive technology detection, evidence, and known-version advisory checks. Quiet by default; inspect in a popup or side panel.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "sidePanel",
    "alarms",
    "webRequest",
    "tabs"
  ],
  "optional_permissions": [
    "notifications"
  ],
  "host_permissions": [
    "https://api.osv.dev/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "VulnWatch \u2014 inspect this page",
    "default_popup": "ui/index.html?view=popup",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "ui/index.html?view=panel"
  },
  "options_ui": {
    "page": "ui/index.html?view=settings",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'; connect-src https://api.osv.dev https://api.github.com https://wpscan.com https://services.nvd.nist.gov"
  }
}
